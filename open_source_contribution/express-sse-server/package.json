{
  "name": "mcp-express-sse-example",
  "version": "1.0.0",
  "description": "Production recipe for Model Context Protocol (MCP) Streamable HTTP/SSE transport with Express and session lifecycle management",
  "main": "dist/server.js",
  "type": "module",
  "scripts": {
    "build": "tsc",
    "start": "node dist/server.js",
    "dev": "tsx watch src/server.ts",
    "client": "node dist/client.js"
  },
  "keywords": [
    "mcp",
    "model-context-protocol",
    "express",
    "sse",
    "streamable-http",
    "server-sent-events"
  ],
  "author": "Manthan (https://github.com/Manthan-cpp)",
  "license": "Apache-2.0",
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.6.1",
    "cors": "^2.8.5",
    "express": "^4.21.2",
    "zod": "^3.24.2"
  },
  "devDependencies": {
    "@types/cors": "^2.8.17",
    "@types/express": "^4.17.21",
    "@types/node": "^22.13.4",
    "tsx": "^4.19.3",
    "typescript": "^5.7.3"
  }
}
