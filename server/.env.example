# EchoSight MCP Server Environment Variables
# Google Gemini API key obtained from Google AI Studio (https://aistudio.google.com/)
# Free tier requires no credit card.
GEMINI_API_KEY=your_gemini_api_key_here

# Reasoning model selection (fast multimodal reasoning with native video support)
GEMINI_MODEL=gemini-3.8-flash

# MCP Server HTTP/SSE Port
PORT=3001

# Environment
NODE_ENV=development
